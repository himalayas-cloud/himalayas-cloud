rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // -------------------------------------------------------------
    // USERS COLLECTION
    // Path: /users/{userId}
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // PROPERTIES COLLECTION
    // Path: /properties/{propertyId}
    // -------------------------------------------------------------
    match /properties/{propertyId} {
      // Anyone can browse listings
      allow read: if true;
      
      // Any logged-in owner can create listings
      allow create: if isAuthenticated();
      
      // Owners can update or delete their own listings (by UID or verified email)
      allow update, delete: if isAuthenticated() 
        && (resource.data.ownerUid == request.auth.uid 
            || (resource.data.ownerEmail != null && request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email)
            || !('ownerUid' in resource.data));
    }

    // -------------------------------------------------------------
    // PROPERTY IMAGES COLLECTION
    // Path: /propertyImages/{propertyId}
    // -------------------------------------------------------------
    match /propertyImages/{propertyId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // META COLLECTION (for live version bumps and instant visitor sync)
    // Path: /meta/{docId}
    // -------------------------------------------------------------
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // -------------------------------------------------------------
    // REPORTS COLLECTION
    // Path: /reports/{reportId}
    // -------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }
  }
}
