rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // -------------------------------------------------------------
    // USERS COLLECTION
    // Path: /users/{userId}
    // Users can only read and write their own profile
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // PROPERTIES COLLECTION
    // Path: /properties/{propertyId}
    // -------------------------------------------------------------
    match /properties/{propertyId} {
      // Anyone can browse listings
      allow read: if true;
      
      // Logged-in owner can only create listings with their own ownerUid
      allow create: if isAuthenticated() 
        && request.resource.data.ownerUid == request.auth.uid;
      
      // Owners can only update or delete their own listings (by UID or verified email)
      allow update, delete: if isAuthenticated() 
        && (resource.data.ownerUid == request.auth.uid 
            || (resource.data.ownerEmail != null && request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email));
    }

    // -------------------------------------------------------------
    // PROPERTY IMAGES COLLECTION
    // Path: /propertyImages/{propertyId}
    // -------------------------------------------------------------
    match /propertyImages/{propertyId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // META COLLECTION (for live version bumps and instant visitor sync)
    // Path: /meta/{docId}
    // Only allows updating version and updatedAt timestamp
    // -------------------------------------------------------------
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version', 'updatedAt']);
    }

    // -------------------------------------------------------------
    // REPORTS COLLECTION
    // Path: /reports/{reportId}
    // -------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && resource.data.reportedByUid == request.auth.uid;
    }
  }
}
